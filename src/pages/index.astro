---
import '@fontsource/cormorant-garamond/400.css'
import '@fontsource/cormorant-garamond/600.css'
const base = import.meta.env.BASE_URL
const displayFont = `@font-face{font-family:'Noto Serif SC';src:url('${base}fonts/noto-serif-sc-subset.woff2') format('woff2');font-display:swap;}`
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>易经六十四卦 · 六爻在线起卦</title>
    <meta
      name="description"
      content="一方庭院，一炷香，六次掷币。基于《周易》六爻占法的在线起卦工具。"
    />
    <meta name="theme-color" content="#ece5d3" />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <style set:html={displayFont}></style>
    <link rel="preload" href={`${base}fonts/noto-serif-sc-subset.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // 早于首帧定明暗，避免海报闪色（与 ink/themes.ts 同一取法）
      (function () {
        var q = new URLSearchParams(location.search).get('theme')
        var stored = null
        try {
          stored = sessionStorage.getItem('sy-theme')
        } catch (e) {}
        var theme = q || stored
        var dark = theme
          ? theme === 'dusk' || theme === 'snow'
          : (function () {
              var h
              try {
                h = Number(
                  new Intl.DateTimeFormat('en-GB', {
                    timeZone: 'Asia/Shanghai',
                    hour: '2-digit',
                    hour12: false,
                  }).format(new Date()),
                )
              } catch (e) {
                h = new Date().getHours()
              }
              return !(h >= 6 && h < 18)
            })()
        document.documentElement.classList.add(dark ? 'theme-dark' : 'theme-light')
      })()
    </script>
    <style>
      :root {
        --paper: #ece5d3;
        --paper-deep: #ddd2ba;
        --ink: #2a2620;
        --dim: #6b6357;
        --accent: #a63b2a;
        --slip: #f3eede;
        --chip-bg: rgba(243, 238, 222, 0.78);
        --chip-border: rgba(42, 38, 32, 0.32);
        --chip-text: #3a352c;
        --poster-glow: rgba(166, 59, 42, 0.07);
      }
      html.theme-dark {
        --paper: #1b2230;
        --paper-deep: #131824;
        --ink: #d9d2c2;
        --dim: #8b93a0;
        --accent: #c8553d;
        --slip: #232c3c;
        --chip-bg: rgba(27, 34, 48, 0.72);
        --chip-border: rgba(217, 210, 194, 0.3);
        --chip-text: #d9d2c2;
        --poster-glow: rgba(212, 168, 83, 0.08);
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: 'Cormorant Garamond', 'Noto Serif SC', 'Songti SC', serif;
        overflow: hidden;
        transition: background-color .9s ease, color .9s ease;
      }

      /* 海报：2D 纸卷就绪前显示 */
      #poster {
        position: fixed; inset: 0; z-index: 3;
        display: grid; place-content: center; justify-items: center;
        gap: 18px;
        background:
          radial-gradient(circle at 50% 30%, var(--poster-glow), transparent 46%),
          linear-gradient(180deg, var(--paper) 0%, var(--paper-deep) 100%);
        transition: opacity .7s ease;
      }
      #poster h1, .result-card h2, .seal { font-family: 'Noto Serif SC', 'Songti SC', serif; }
      #poster h1 {
        font-size: clamp(2rem, 6vw, 3.4rem);
        font-weight: 400;
        letter-spacing: .22em;
        text-indent: .22em;
      }
      #poster p { color: var(--dim); letter-spacing: .18em; font-size: .85rem; }
      #poster .rule { width: 46px; height: 1px; background: var(--chip-border); }
      .btn {
        margin-top: 10px;
        padding: 13px 34px;
        background: transparent;
        color: var(--ink);
        border: 1px solid var(--chip-border);
        border-radius: 2px;
        font-family: inherit;
        font-size: .95rem;
        letter-spacing: .3em;
        text-indent: .3em;
        cursor: pointer;
        transition: border-color .3s, background .3s, color .3s;
      }
      .btn:hover { border-color: var(--accent); background: var(--poster-glow); }
      .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

      body.ready #poster { opacity: 0; pointer-events: none; }

      /* 2D 纸卷 */
      canvas#scene {
        position: fixed; inset: 0; width: 100%; height: 100%;
        display: block; opacity: 0; transition: opacity 1.1s ease;
      }
      body.scene-live canvas#scene { opacity: 1; }
      body.no-canvas canvas#scene { display: none; }

      /* 卦纸：六爻落在画上一张小签纸 */
      #board {
        position: fixed; left: 50%; top: 43%; z-index: 2;
        width: clamp(96px, 16vh, 150px); height: auto;
        transform: translate(-50%, -50%) rotate(-1.4deg);
        opacity: 0; pointer-events: none;
        transition: opacity .7s ease .15s;
        filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.12));
      }
      body.ready #board { opacity: 1; }
      #board .slip {
        fill: var(--slip);
        stroke: var(--ink);
        stroke-opacity: .2;
        stroke-width: 1;
      }
      #board :global(.bar) {
        fill: var(--ink);
        opacity: 0;
        transform: scaleX(.55);
        transform-box: fill-box;
        transform-origin: center;
        transition: transform .5s cubic-bezier(.22, 1, .36, 1), opacity .5s ease;
      }
      #board :global(.bar.shown) { opacity: .85; transform: scaleX(1); }
      #board :global(.bar.moving) { fill: var(--accent); }

      .ritual-btn {
        position: fixed; left: 50%; bottom: 36px; transform: translateX(-50%);
        z-index: 3; opacity: 0; pointer-events: none; transition: opacity .6s ease;
        background: var(--chip-bg); color: var(--chip-text);
        border: 1px solid var(--chip-border);
        backdrop-filter: blur(6px);
      }
      body.ready .ritual-btn { opacity: 1; pointer-events: auto; }
      body.ready .ritual-btn:hover { border-color: var(--accent); }

      .result-card {
        position: fixed; right: 34px; top: 50%; transform: translateY(-50%);
        z-index: 4; width: min(330px, calc(100vw - 40px));
        max-height: 84vh; overflow-y: auto;
        padding: 26px 26px 22px;
        background: #d8cdb6;
        color: #1b1a17;
        border: 1px solid rgba(27, 26, 23, .28);
        border-radius: 0;
        box-shadow: 0 18px 40px rgba(0, 0, 0, .35);
        display: none;
      }
      .result-card::before {
        content: '';
        position: absolute; inset: 6px;
        border: 1px solid rgba(27, 26, 23, .18);
        pointer-events: none;
      }
      .result-card.open { display: block; }
      .seal {
        position: absolute; top: 18px; right: 18px; width: 42px; height: 42px;
        display: grid; place-content: center; background: #a63b2a; color: #f3ead8;
        font-size: 1.15rem; letter-spacing: 0; transform: rotate(2deg);
        box-shadow: inset 0 0 0 2px rgba(243,234,216,.5);
      }
      .result-eyebrow { color: #a63b2a; font-size: .75rem; letter-spacing: .25em; }
      .result-card h2 { font-size: 1.6rem; font-weight: 400; letter-spacing: .16em; margin: 6px 0 2px; }
      .result-pinyin { color: #6b6357; font-size: .8rem; letter-spacing: .1em; margin-bottom: 12px; }
      .result-judgment { font-size: .95rem; line-height: 1.95; color: #2c2925; margin-bottom: 8px; }
      .result-interp { font-size: .85rem; line-height: 1.9; color: #4a453d; margin-bottom: 16px; }
      .result-card .btn-sm { font-size: .8rem; padding: 9px 22px; border-color: rgba(27,26,23,.4); color: #1b1a17; }
      :global(.glyph) { display: flex; flex-direction: column; gap: 6px; width: 132px; margin: 12px 0 14px; }
      :global(.glyph-row) { display: flex; gap: 8px; height: 7px; }
      :global(.glyph-bar) { flex: 1; background: #2c2925; border-radius: 1px; }
      :global(.glyph-row.moving .glyph-bar) { background: #a63b2a; box-shadow: 0 0 6px rgba(166,59,42,.35); }
      .result-sub { font-size: .8rem; color: #5c5549; letter-spacing: .04em; margin: 2px 0; }
      .sound-btn {
        position: fixed; top: 18px; right: 18px; z-index: 5;
        background: var(--chip-bg); color: var(--chip-text);
        border: 1px solid var(--chip-border); border-radius: 2px;
        padding: 7px 14px; font-family: inherit; font-size: .75rem;
        letter-spacing: .1em; cursor: pointer; backdrop-filter: blur(6px);
      }
      .sound-btn:hover { border-color: var(--accent); }

      @media (max-width: 640px) {
        .result-card { right: 16px; left: 16px; top: auto; bottom: 16px; transform: none; width: auto; max-height: 62vh; padding: 18px; }
        .ritual-btn { bottom: 64px; }
        #board { top: 40%; }
      }

      .ritual-progress {
        position: fixed; left: 50%; bottom: 84px; transform: translateX(-50%);
        z-index: 3; color: var(--ink); opacity: .75; letter-spacing: .5em;
        font-size: .8rem; pointer-events: none;
      }
      .corner-nav {
        position: fixed; left: 22px; bottom: 24px; z-index: 5;
        display: flex; gap: 10px;
      }
      .nav-btn {
        font-family: inherit; font-size: .78rem; letter-spacing: .18em;
        padding: 7px 14px; color: var(--chip-text); background: var(--chip-bg);
        border: 1px solid var(--chip-border); cursor: pointer;
        backdrop-filter: blur(6px);
      }
      .nav-btn:hover { border-color: var(--accent); }
      .panel {
        position: fixed; left: 0; top: 0; bottom: 0; width: min(340px, 86vw);
        z-index: 6; background: #d8cdb6; color: #1b1a17;
        border-right: 1px solid rgba(27, 26, 23, .35);
        transform: translateX(-102%); transition: transform .35s ease;
        display: flex; flex-direction: column; padding: 18px 18px 14px;
        overflow: hidden;
      }
      .panel.open { transform: translateX(0); }
      .panel-head {
        display: flex; align-items: center; justify-content: space-between;
        font-size: 1.02rem; letter-spacing: .22em; padding-bottom: 10px;
        border-bottom: 1px solid rgba(27, 26, 23, .2);
      }
      .panel-close {
        border: none; background: none; font-size: 1.1rem; color: #1b1a17;
        cursor: pointer; line-height: 1; padding: 2px 6px;
      }
      .panel-search {
        margin: 12px 0 8px; padding: 8px 10px; font-family: inherit;
        font-size: .82rem; color: #1b1a17; background: rgba(255, 250, 240, .5);
        border: 1px solid rgba(27, 26, 23, .28); outline: none;
      }
      .panel-search:focus { border-color: #a63b2a; }
      .history-list { list-style: none; margin: 6px 0 0; padding: 0; overflow-y: auto; flex: 1; }
      :global(.history-item) {
        display: flex; align-items: baseline; gap: 10px; padding: 9px 4px;
        border-bottom: 1px dashed rgba(27, 26, 23, .18); cursor: pointer;
      }
      :global(.history-item:hover) { color: #a63b2a; }
      :global(.history-time) { font-size: .72rem; color: #6b6357; min-width: 74px; }
      :global(.history-name) { flex: 1; font-size: .98rem; letter-spacing: .1em; }
      :global(.history-fortune) { font-size: .7rem; color: #a63b2a; }
      .panel-empty { color: #6b6357; font-size: .8rem; line-height: 1.8; }
      .panel-actions { padding-top: 10px; text-align: center; }
      .panel-actions .btn-sm { font-size: .72rem; padding: 6px 14px; border-color: rgba(27, 26, 23, .35); color: #1b1a17; }
      .browse-grid {
        margin-top: 4px; display: grid; grid-template-columns: repeat(2, 1fr);
        gap: 6px; overflow-y: auto; padding-right: 4px; flex: 1;
      }
      :global(.browse-item) {
        display: flex; flex-direction: column; gap: 2px; text-align: left;
        padding: 7px 9px; background: rgba(255, 250, 240, .35);
        border: 1px solid rgba(27, 26, 23, .18); color: #1b1a17;
        font-family: inherit; cursor: pointer;
      }
      :global(.browse-item:hover) { border-color: #a63b2a; }
      :global(.b-num) { font-size: .66rem; color: #8a6a3a; }
      :global(.b-name) { font-size: .92rem; letter-spacing: .1em; }
      :global(.b-sub) { font-size: .62rem; color: #6b6357; }
      .result-image { font-size: .8rem; line-height: 1.85; color: #4a453d; margin: 2px 0 10px; }
      .result-source { font-size: .68rem; color: #8a6b3a; letter-spacing: .12em; margin-top: 6px; }

      @media (max-width: 640px) {
        .ritual-progress { bottom: 96px; }
        .corner-nav { bottom: 18px; left: 14px; }
      }

      @media (prefers-reduced-motion: reduce) {
        #poster, canvas#scene, #board { transition: none; }
        #board .bar { transition: opacity .2s ease; transform: none; }
      }
    </style>
  </head>
  <body>
    <div id="poster">
      <h1>易经六十四卦</h1>
      <div class="rule"></div>
      <p>心诚则灵 · 以卦明理</p>
      <button class="btn" id="begin" type="button">抽 取 一 卦</button>
    </div>
    <canvas id="scene" aria-hidden="true"></canvas>

    <svg id="board" viewBox="0 0 128 150" aria-hidden="true">
      <rect class="slip" x="1.5" y="1.5" width="125" height="147" rx="3"></rect>
      <g id="boardRows"></g>
    </svg>

    <button id="ritualBtn" class="btn ritual-btn" type="button">抽 取 一 卦</button>
    <button id="soundBtn" class="sound-btn" type="button" aria-pressed="false">声音 · 关</button>

    <section id="result" class="result-card" aria-live="polite">
      <div class="result-eyebrow">第 <span id="resultNumber"></span> 卦</div>
      <h2 id="resultName"></h2>
      <div id="resultSeal" class="seal" aria-hidden="true"></div>
      <p id="resultPinyin" class="result-pinyin"></p>
      <div id="resultGlyph" class="glyph" aria-hidden="true"></div>
      <p id="resultHexes" class="result-sub"></p>
      <p id="resultMoving" class="result-sub"></p>
      <p id="resultJudgment" class="result-judgment"></p>
      <p id="resultImage" class="result-image"></p>
      <p id="resultInterp" class="result-interp"></p>
      <p id="resultSource" class="result-source"></p>
      <button id="againBtn" class="btn btn-sm" type="button">再 占 一 卦</button>
    </section>
    <div id="ritualProgress" class="ritual-progress" aria-hidden="true"></div>
    <nav class="corner-nav" aria-label="资料">
      <button id="historyBtn" class="nav-btn" type="button">记录</button>
      <button id="browseBtn" class="nav-btn" type="button">卦库</button>
    </nav>
    <aside id="historyPanel" class="panel" aria-label="占卜记录">
      <header class="panel-head"><span>占卜记录</span><button id="closeHistory" class="panel-close" type="button" aria-label="关闭">×</button></header>
      <ul id="historyList" class="history-list"></ul>
      <p id="historyEmpty" class="panel-empty">还没有记录。掷满六爻后会自动存进这里。</p>
      <div id="historyActions" class="panel-actions"><button id="clearHistory" class="btn-sm" type="button">清 除 全 部</button></div>
    </aside>
    <aside id="browsePanel" class="panel" aria-label="卦库">
      <header class="panel-head"><span>卦库</span><button id="closeBrowse" class="panel-close" type="button" aria-label="关闭">×</button></header>
      <input id="searchHex" class="panel-search" type="search" placeholder="搜索卦名 / 拼音 / 序号" />
      <div id="browseGrid" class="browse-grid"></div>
    </aside>
    <noscript><p style="position:fixed;inset:0;display:grid;place-content:center">请启用 JavaScript。</p></noscript>
    <script>
      performance.mark('html:ready')
      import { ambient } from '../lib/ambient'
      import hexagrams from '../data/hexagrams.json'
      import { bindPanels, saveRecord } from '../lib/archive'
      import type { Hexagram } from '../lib/hexagram'
      const soundBtn = document.getElementById('soundBtn')
      const syncSound = () => {
        if (soundBtn) soundBtn.textContent = ambient.muted ? '声音 · 关' : '声音 · 开'
      }
      soundBtn?.addEventListener('click', () => {
        ambient.toggle()
        syncSound()
      })
      syncSound()

      window.addEventListener('ritual:complete', (event) => {
        const detail = (event as CustomEvent<{ values: number[] }>).detail
        if (detail?.values?.length === 6) saveRecord({ t: Date.now(), values: detail.values })
      })
      bindPanels({ hexagrams: hexagrams as unknown as Hexagram[] })

      const panelParam = new URLSearchParams(location.search).get('panel')
      if (panelParam === 'browse') document.getElementById('browseBtn')?.click()
      if (panelParam === 'history') document.getElementById('historyBtn')?.click()

      // 卦纸与按钮先就绪（body.ready），2D 纸卷随后淡入（body.scene-live）
      const start = () => {
        performance.mark('boot:import')
        Promise.all([import('../scripts/ritual'), import('../scripts/scene')]).then(([ritual, scene]) => {
          performance.mark('boot:imported')
          ritual.bootRitual()
          scene.boot()
        })
      }
      if (new URLSearchParams(location.search).get('bench') === '1') {
        window.setTimeout(() => {
          const marks = performance.getEntriesByType('mark').map((m) => `${m.name}=${Math.round(m.startTime)}`).join(' | ')
          const pre = document.createElement('pre')
          pre.id = 'bench'
          pre.textContent = marks
          pre.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:99;color:#0f0;background:#000a;font:11px monospace;padding:6px;max-width:90vw;white-space:normal'
          document.body.appendChild(pre)
        }, 4000)
      }
      const idle = (window as unknown as { requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => void })
        .requestIdleCallback
      if (typeof idle === 'function') idle(start, { timeout: 1200 })
      else window.setTimeout(start, 400)
    </script>
  </body>
</html>
